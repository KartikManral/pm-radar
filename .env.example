# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# --- AI resume match (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model. Default "gemini-flash-latest" follows Google's current Flash model.
# GEMINI_MODEL=gemini-flash-latest
# Optional: match checks allowed per visitor per day (protects your free quota). Default 25.
# MATCH_DAILY_LIMIT=25

# --- Subscriber storage (free): add "Upstash for Redis" from the Vercel Marketplace.
# Vercel fills these in automatically (as KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sending email (free): a Gmail account + app password.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
SMTP_USER=yourname@gmail.com
SMTP_PASS=
# MAIL_FROM="PM Radar <yourname@gmail.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Protects the daily email job. Any long random string.
CRON_SECRET=

# --- Your live site address, used for links inside emails.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# --- Set to 1 to use sample jobs and a sample AI result (no internet or keys needed).
# MOCK_JOBS=1
